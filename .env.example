# Server Configuration
PORT=3000

# Serial Port Configuration
# Windows (testing): COM3, COM4, etc.
# Raspberry Pi with USB adapter: /dev/ttyUSB0, /dev/ttyACM0
# Raspberry Pi GPIO UART (direct connection to AS32-TTL-100): /dev/ttyAMA0 or /dev/serial0
# Mac: /dev/cu.usbserial-*
SERIAL_PORT=/dev/ttyAMA0
BAUD_RATE=9600
USE_GPIO_LORA_MODE=false

# Memory optimization (adjust for Raspberry Pi)
MAX_HISTORY=500

# Backup configuration
# Backup interval in milliseconds (default: 3600000 = 1 hour)
BACKUP_INTERVAL=3600000

# Analytics & forecast configuration
ANALYTICS_WINDOW_MINUTES=120
ANALYTICS_FORECAST_MINUTES=30
ANALYTICS_TEMP_HIGH=32
ANALYTICS_HUM_HIGH=75
ANALYTICS_ANOMALY_ZSCORE=2.5
NODE_OFFLINE_SECONDS=150
